{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile OutputManager Sketch",
            "type": "shell",
            "command": "arduino-cli",
            "args": [
                "compile",
                "--fqbn",
                "arduino:avr:uno",
                "--output-dir",
                "OutputManager/build",
                "OutputManager/OutputManager.ino"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Compile SensorsManager Sketch",
            "type": "shell",
            "command": "arduino-cli",
            "args": [
                "compile",
                "--fqbn",
                "arduino:avr:uno",
                "--output-dir",
                "SensorsManager/build",
                "SensorsManager/SensorsManager.ino"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Compile All Sketches",
            "dependsOn": [
                "Compile OutputManager Sketch",
                "Compile SensorsManager Sketch"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}
